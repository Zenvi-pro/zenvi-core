# Zenvi Core — Frontend Environment Configuration
# Copy this file to .env and fill in your values.
# run.sh loads .env automatically. You can still override any value by
# setting it in your shell before running run.sh.

# ── Backend connection ──────────────────────────────────────────────────────
# URL of the running zenvi-backend server.
ZENVI_BACKEND_URL=http://localhost:8500

# ── Remotion services ────────────────────────────────────────────────────────
# URL of the product-launch Remotion rendering service.
REMOTION_PRODUCT_LAUNCH_URL=http://localhost:4500/api/v1

# ── Zenvi website ────────────────────────────────────────────────────────────
# Used for the browser-based OAuth login flow (/login?state=<uuid>).
ZENVI_WEBSITE=http://localhost:8080

# ── Supabase auth ────────────────────────────────────────────────────────────
# Must match the project used by zenvi-backend.
SUPABASE_URL=https://xktarhzbrdnxkaovtdxj.supabase.co
SUPABASE_ANON_KEY=
