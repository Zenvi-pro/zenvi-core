# Zenvi Core — Frontend Environment Configuration
# Copy this file to .env and adjust values for your setup.
# zenvi-backend must be running before launching zenvi-core.

# ── Backend connection ──────────────────────────────────────────────────────
# URL of the running zenvi-backend server.
ZENVI_BACKEND_URL=http://localhost:8500

# ── Remotion services ────────────────────────────────────────────────────────
# URL of the product-launch Remotion rendering service (used for post-import Supabase cleanup).
REMOTION_PRODUCT_LAUNCH_URL=http://localhost:3100

# ── Zenvi website ────────────────────────────────────────────────────────────
# Used for the browser-based OAuth login flow (/login?state=<uuid>).
ZENVI_WEBSITE=https://zenvi.pro

# ── Supabase auth ────────────────────────────────────────────────────────────
# These are read-only public values (safe to commit).
# SUPABASE_URL and SUPABASE_ANON_KEY must match what zenvi-backend uses.
# Leave blank if you are not using the login / tier-enforcement features.
SUPABASE_URL=https://fmeawyasfffvyoactenu.supabase.co
SUPABASE_ANON_KEY=

# ── Auto-update checker (production only) ────────────────────────────────────
# GitHub repository slug checked on startup for new releases.
# Format: "owner/repo" — e.g. zenvi-team/zenvi-core
# Leave blank (default) to disable the version check. When unset, the updater
# thread exits silently so development and self-hosted builds are unaffected.
# Set this in .env.production or your deployment environment, not here.
ZENVI_GITHUB_REPO=
