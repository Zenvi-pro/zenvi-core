# Zenvi Core — Frontend Environment Configuration
# Copy this file to .env and adjust values for your setup.
# zenvi-backend must be running before launching zenvi-core.
# Packaged builds also ship .env.production (defaults); .env wins for any key you set here.

# ── Backend connection ──────────────────────────────────────────────────────
# URL of the running zenvi-backend server.
ZENVI_BACKEND_URL=http://localhost:8500
# Seconds the backend may stay unreachable mid-indexing before the file is marked failed.
ZENVI_INDEX_UNREACHABLE_SEC=180

# ── Indexing ────────────────────────────────────────────────────────────────
# Video shorter than this is upscaled (ffmpeg lanczos) before it is sent for
# indexing; the backend's GEMINI_INDEX_MAX_HEIGHT still caps it. 0 = off.
ZENVI_INDEX_MIN_HEIGHT=720

# ── Zenvi website ────────────────────────────────────────────────────────────
# Used for the browser-based OAuth login flow (/login?state=<uuid>).
ZENVI_WEBSITE=https://zenvi.pro

# ── Zenvi Cloud ──────────────────────────────────────────────────────────────
# File → Zenvi Cloud (push, open in the web editor at ZENVI_WEBSITE/editor,
# open a cloud project). Unset = the deployed service; Preferences → AI →
# "Zenvi Cloud URL" also sets it. The cloud accepts this file's SUPABASE_URL
# sessions only when it is the zenvi.pro project (xktarhzbrdnxkaovtdxj).
# ZENVI_CLOUD_URL=http://localhost:8080

# ── Supabase auth ────────────────────────────────────────────────────────────
# These are read-only public values (safe to commit).
# SUPABASE_URL and SUPABASE_ANON_KEY must match what zenvi-backend uses.
# Leave blank if you are not using the login / tier-enforcement features.
SUPABASE_URL=https://fmeawyasfffvyoactenu.supabase.co
SUPABASE_ANON_KEY=
