/* Zenvi dark: true-black base, hairline structure, one accent.
   Colors are token placeholders (see tokens.py); {PATH} is the app root. */

/* ── Window, dialogs ─────────────────────────────────────── */
QMainWindow { background-color: {bg}; color: {text}; }
QDialog { background-color: {surface}; color: {text}; }
QWidget { color: {text}; }

/* Panels meet on a 1px hairline; it lights up when you can drag it */
QMainWindow::separator { background: {line}; width: 1px; height: 1px; }
QMainWindow::separator:hover { background: {accent}; }

QToolTip {
    background-color: {raised};
    color: {text};
    border: 1px solid {line_strong};
    border-radius: 6px;
    padding: 5px 9px;
}

QWidget#tutorial {
    background-color: {raised};
    border: 1px solid {line_strong};
    border-radius: 10px;
    padding: 20px;
}
QLabel#lblTutorialText { font-size: 14px; }
QCheckBox#checkboxMetrics { font-size: 13px; }
QLabel#lblMissingFileHint, QLabel#lblMissingFilePath { color: {text_muted}; }

QWidget#Simple, QWidget#Advanced, QWidget#PreferencePanel,
QWidget#settingsContainer, QWidget#scrollAreaWidgetContents {
    background-color: {surface};
    border: none;
}
QScrollArea { border: none; background: transparent; }
QTabWidget { border: none; }
QTabWidget::pane { border: none; border-top: 1px solid {line}; }

/* ── Menu bar and menus ──────────────────────────────────── */
QMenuBar {
    background-color: {bg};
    color: {text_muted};
    border: none;
    padding: 2px 6px;
}
QMenuBar::item { padding: 4px 9px; background: transparent; border-radius: 5px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: {hover}; color: {text}; }

QMenu {
    background-color: {raised};
    color: {text};
    border: 1px solid {line_strong};
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 6px 24px 6px 26px; border-radius: 5px; }
QMenu::item:checked { padding: 6px 24px 6px 26px; }
QMenu::item:selected { background-color: {hover}; color: {white}; }
QMenu::item:disabled { color: {text_off}; }
QMenu::indicator { width: 12px; height: 12px; left: 8px; }
QMenu::indicator:checked { image: url({PATH}themes/cosmic/images/dropdown-tick.svg); }
QMenu::separator { height: 1px; background: {line_strong}; margin: 4px 6px; }

/* ── Toolbars ────────────────────────────────────────────── */
QToolBar#toolBar {
    background-color: {bg};
    border: none;
    border-bottom: 1px solid {line};
    spacing: 2px;
    padding: 3px 6px;
}
QToolBar#toolBar QToolButton {
    background-color: transparent;
    color: {text_muted};
    padding: 6px 8px;
    border: none;
    border-radius: 6px;
}
QToolBar#toolBar QToolButton:hover   { background-color: {hover}; color: {text}; }
QToolBar#toolBar QToolButton:pressed { background-color: {active}; }

QToolBar#timelineToolbar {
    background-color: {surface};
    border: none;
    border-bottom: 1px solid {line};
    spacing: 0;
    padding: 2px 4px;
}
QToolBar#timelineToolbar QToolButton {
    color: {text_muted};
    background-color: transparent;
    padding: 5px 6px;
    margin: 2px 1px;
    border-radius: 6px;
    border: none;
}
QToolBar#timelineToolbar QToolButton:hover   { background-color: {hover}; color: {text}; }
QToolBar#timelineToolbar QToolButton:pressed { background-color: {active}; }
QToolBar#timelineToolbar QToolButton:checked { background-color: {accent_soft}; color: {text}; }

QToolBar QToolButton:hover   { background-color: {hover}; }
QToolBar QToolButton:pressed { background-color: {active}; }
QToolBar::separator { background: {line_strong}; width: 1px; margin: 6px 4px; }

/* ── Buttons: secondary by default, light primary for the main action ── */
QPushButton {
    background-color: {raised};
    color: {text};
    border: 1px solid {line_strong};
    border-radius: 6px;
    padding: 5px 12px;
    min-height: 20px;
}
QPushButton:hover    { background-color: {hover}; border-color: {active}; }
QPushButton:pressed  { background-color: {active}; }
QPushButton:disabled { color: {text_off}; background-color: {surface}; border-color: {line}; }
QPushButton:flat     { background: transparent; border: none; }
QPushButton:flat:hover { background: {hover}; }

QPushButton#acceptButton, QWidget#cutting QPushButton#btnAddClip {
    background-color: {primary};
    color: {primary_text};
    border: none;
    padding: 5px 14px;
    font-weight: 600;
}
QPushButton#acceptButton:hover, QWidget#cutting QPushButton#btnAddClip:hover { background-color: {primary_hover}; }
QPushButton#acceptButton:disabled, QWidget#cutting QPushButton#btnAddClip:disabled {
    background-color: {raised};
    color: {text_off};
}

/* ── Panel headers (Qt-drawn dock title bars) ───────────── */
QLabel { color: {text}; }
QWidget#dock-title-bar {
    background-color: {surface};
    border-bottom: 1px solid {line};
}
QLabel#dock-title-label {
    color: {text_muted};
    font-weight: 600;
    padding: 0 12px;
    font-size: 12px;
}
QLabel#dock-title-handle {
    padding-left: 12px;
    qproperty-pixmap: url({PATH}themes/cosmic/images/dock-move.svg);
}
QPushButton#dock-float-button, QPushButton#dock-close-button {
    background: transparent;
    border: none;
    border-radius: 5px;
    color: {text_faint};
    font-size: 12px;
    padding: 0;
    min-height: 0;
}
QPushButton#dock-float-button:hover { background: {hover}; color: {text}; }
QPushButton#dock-close-button:hover { background: {hover}; color: {danger}; }

QDockWidget {
    background-color: {surface};
    titlebar-close-icon:  url({PATH}themes/cosmic/images/dock-close.svg);
    titlebar-normal-icon: url({PATH}themes/cosmic/images/dock-float.svg);
    color: {text};
}
QDockWidget::title {
    background-color: {surface};
    border-bottom: 1px solid {line};
    padding: 8px 12px;
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    max-width: 0; max-height: 0; padding: 0; margin: 0;
    border: none; background: transparent; image: none;
}
QDockWidget QWidget { border: none; }

QDockWidget QWidget#dockFilesContents,
QWidget#dockTransitionsContents,
QWidget#dockEmojisContents,
QWidget#dockEffectsContents,
QWidget#dockCaptionContents,
QWidget#dockPropertiesContents,
QWidget#PexelsDockContents,
QWidget#FreesoundDockContents,
QWidget#AIChatWindowContents,
QWidget#AIMediaPanelContents {
    background-color: {surface};
    margin: 0;
}
QWidget#dockVideoContents { background-color: {bg}; margin: 0; }
QWidget#videoPreview { background-color: {bg}; border: none; }
QDockWidget QWidget#dockTimelineContents { margin: 0; padding: 0; background-color: {surface}; }

/* ── Tabs ────────────────────────────────────────────────── */
QTabBar { border: none; qproperty-drawBase: 0; qproperty-expanding: 0; background: {bg}; }

/* Activity bar: icon-only panel tabs (text hidden, icons drawn by the theme) */
QTabBar::tab {
    background: transparent;
    color: transparent;
    font-size: 1px;
    border: none;
    padding: 0;
    margin: 2px 0;
    border-left: 2px solid transparent;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    text-align: center;
}
QTabBar::tab:selected { background: transparent; border-left: 2px solid {text}; }
QTabBar::tab:hover:!selected { background: {hover}; }

/* Dialog tabs with labels */
QTabWidget#exportTabs QTabBar::tab,
QTabWidget#tabCategories QTabBar::tab,
QTabWidget#tabCredits QTabBar::tab,
QTabWidget#tabChangelog QTabBar::tab,
QTabWidget#tabWidget QTabBar::tab,
QTabWidget#generateTabs QTabBar::tab {
    color: {text_faint};
    font-size: 13px;
    min-width: 0; min-height: 0; max-width: 400px;
    padding: 7px 12px;
    margin: 0 2px 0 0;
    border: none;
    border-bottom: 2px solid transparent;
    text-align: center;
}
QTabWidget#exportTabs QTabBar::tab:selected,
QTabWidget#tabCategories QTabBar::tab:selected,
QTabWidget#tabCredits QTabBar::tab:selected,
QTabWidget#tabChangelog QTabBar::tab:selected,
QTabWidget#tabWidget QTabBar::tab:selected,
QTabWidget#generateTabs QTabBar::tab:selected {
    color: {text};
    border-bottom: 2px solid {text};
    background: transparent;
}
QTabWidget#exportTabs QTabBar::tab:hover:!selected,
QTabWidget#tabCategories QTabBar::tab:hover:!selected,
QTabWidget#tabWidget QTabBar::tab:hover:!selected,
QTabWidget#generateTabs QTabBar::tab:hover:!selected { color: {text}; background: transparent; }

/* ── Inputs ──────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: {sunken};
    color: {text};
    border: 1px solid {line_strong};
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: {accent};
    selection-color: {white};
}
QTextEdit, QPlainTextEdit { padding: 4px; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: {active}; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus { border-color: {accent}; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { color: {text_off}; border-color: {line}; }

/* Panel search boxes read like a command bar */
QLineEdit#filesFilter, QLineEdit#effectsFilter, QLineEdit#transitionsFilter,
QLineEdit#emojisFilter, QLineEdit#txtPropertyFilter {
    background-color: {sunken};
    border: 1px solid {line};
    border-radius: 6px;
    padding: 6px 10px;
}
QLineEdit#filesFilter:focus, QLineEdit#effectsFilter:focus, QLineEdit#transitionsFilter:focus,
QLineEdit#emojisFilter:focus, QLineEdit#txtPropertyFilter:focus { border-color: {accent}; }

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: transparent; border: none; width: 16px;
}

QComboBox {
    background-color: {raised};
    color: {text};
    border: 1px solid {line_strong};
    border-radius: 6px;
    padding: 5px 8px;
    combobox-popup: 0;
}
QComboBox:hover { border-color: {active}; background-color: {hover}; }
QComboBox:focus { border-color: {accent}; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 28px; border: none; }
QComboBox::down-arrow { image: url({PATH}themes/cosmic/images/dropdown-arrow.svg); }
QComboBox QAbstractItemView {
    background-color: {raised};
    color: {text};
    border: 1px solid {line_strong};
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: {hover};
}
QComboBox::item { height: 26px; }
QComboBox::item:selected { background-color: {hover}; }
QComboBox::item:checked { font-weight: 600; }
QComboBox::indicator::checked { image: url({PATH}themes/cosmic/images/dropdown-tick.svg); }

QCheckBox, QRadioButton { color: {text}; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid {active};
    background: {sunken};
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: {text_faint}; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: {accent}; border-color: {accent}; }
QCheckBox::indicator:indeterminate { background: {accent_soft}; border-color: {accent}; }

QSlider::groove:horizontal { background: {active}; height: 2px; border-radius: 1px; }
QSlider::sub-page:horizontal { background: {text_muted}; border-radius: 1px; }
QSlider::handle:horizontal {
    background: {text}; border: none;
    width: 12px; height: 12px; margin: -5px 0; border-radius: 6px;
}
QSlider::handle:horizontal:hover { background: {white}; }
QSlider::groove:vertical { background: {active}; width: 2px; border-radius: 1px; }
QSlider::sub-page:vertical { background: {text_muted}; border-radius: 1px; }
QSlider::handle:vertical {
    background: {text}; border: none;
    width: 12px; height: 12px; margin: 0 -5px; border-radius: 6px;
}

QProgressBar {
    background: {active}; border: none; border-radius: 2px;
    max-height: 4px; text-align: center; color: transparent;
}
QProgressBar::chunk { background: {accent}; border-radius: 2px; }

QGroupBox {
    color: {text_muted};
    font-size: 12px;
    font-weight: 600;
    border: 1px solid {line};
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px; top: 2px;
    padding: 0 4px;
    background: transparent;
    min-width: 0;
}

QToolBox::tab {
    background: {surface};
    color: {text_muted};
    border: none;
    border-bottom: 1px solid {line};
    padding: 7px 10px;
}
QToolBox::tab:selected { color: {text}; }

/* ── Scroll bars: thin, quiet until hovered ─────────────── */
QScrollBar:vertical { border: none; background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: {active}; border-radius: 3px; min-height: 28px; margin: 2px 3px; }
QScrollBar::handle:vertical:hover { background: {text_faint}; }
QScrollBar:horizontal { border: none; background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: {active}; border-radius: 3px; min-width: 28px; margin: 3px 2px; }
QScrollBar::handle:horizontal:hover { background: {text_faint}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ── Lists, trees, tables ────────────────────────────────── */
QTreeView, QListView, QTableView {
    background-color: {surface};
    border: none;
    color: {text};
    outline: none;
    gridline-color: {line};
    alternate-background-color: {surface};
    show-decoration-selected: 1;
}
QTreeView::item, QListView::item { min-height: 24px; padding: 2px 6px; border-radius: 5px; }
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover { background: {hover}; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: {accent_soft};
    color: {white};
}
QHeaderView { background: {surface}; border: none; }
QHeaderView::section {
    background-color: {surface};
    color: {text_faint};
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid {line};
    font-size: 12px;
    font-weight: 600;
}
QHeaderView::section:hover { color: {text}; }

QSplitter::handle { background: {line}; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: {accent}; }

QFrame[frameShape="4"] { background: {line}; max-height: 1px; border: none; margin: 4px 0; }
QFrame[frameShape="5"] { background: {line}; max-width: 1px; border: none; margin: 0 4px; }

QStatusBar {
    background: {bg};
    color: {text_faint};
    font-size: 12px;
    border-top: 1px solid {line};
}

/* ── Keyboard focus (Tab navigation, OpenShot #5912) ─────── */
QToolBar QToolButton:focus { background-color: {active}; border: 1px solid {accent}; }
QToolBar QToolButton:checked:focus { border: 1px solid {accent}; }
QToolBar#toolBar QToolButton:focus,
QToolBar#timelineToolbar QToolButton:focus { background-color: {active}; border: 1px solid {accent}; }
QToolBar#timelineToolbar QToolButton:checked:focus { background-color: {accent_soft}; }
QPushButton:focus { border-color: {accent}; }
QCheckBox:focus { background-color: {hover}; border-radius: 4px; }
QTabBar:focus { outline: none; }
QTabBar::tab:focus { border-bottom: 2px solid {accent}; }
QToolBox::tab:focus { border-left: 2px solid {accent}; }

/* ── Dialog pages ────────────────────────────────────────── */
QWidget#Details, QWidget#Output { background-color: {surface}; }
QWidget#Output QTextEdit { color: {text}; }
QTabWidget QWidget#pageAdvancedOptions, QWidget#pageProfile, QWidget#pageImageSequenceSettings,
QWidget#pageVideoSettings, QWidget#pageAudioSettings, QTabWidget QWidget#pageVideoDetails,
QWidget#pageVideoFormat, QWidget#pageAudioFormat, QWidget#pageFrameSettings {
    background-color: {surface};
}
QWidget#cutting QPushButton#btnStart, QPushButton#btnEnd { border: 1px solid {active}; }
QWidget#cutting QPushButton#btnStart:disabled, QPushButton#btnEnd:disabled { color: {text_off}; border-color: {line}; }

/* ── Painted widgets read these ──────────────────────────── */
.property_value { foreground-color: {text_muted}; background-color: {hover}; }
.zoom_slider_playhead { background-color: {playhead}; }

/* ── Recording dock ──────────────────────────────────────── */
QFrame#recordingCard {
    background-color: {raised};
    border: 1px solid {line_strong};
    border-radius: 10px;
}
QFrame#recordingCard[checked="true"] { border: 1px solid {accent}; background-color: {accent_soft}; }
QFrame#recordingCard[available="false"] { border: 1px solid {line}; background-color: {surface}; }
QLabel#recordingCardIcon { color: {text}; font-size: 20px; }
QLabel#recordingCardTitle { color: {text}; font-size: 13px; font-weight: 600; }
QLabel#recordingCardSubtitle { color: {text_faint}; font-size: 12px; }
QFrame#recordingSection {
    background-color: {surface};
    border: 1px solid {line_strong};
    border-radius: 8px;
}
QFrame#recordingSection[active="true"] { border: 1px solid {accent}; }
QFrame#recordingSection[active="false"] { color: {text_faint}; background-color: {bg}; }
QLabel#recordingSectionIcon { color: {text_muted}; font-size: 15px; }
QLabel#recordingSectionTitle { color: {text}; font-weight: 600; }
QPushButton#recordingAdvancedLink {
    color: {text_muted}; background: transparent; border: none;
    padding: 0; min-height: 0; text-align: right;
}
QPushButton#recordingAdvancedLink:hover { color: {text}; text-decoration: underline; }
QPushButton#recordingSegment {
    border: 1px solid {line_strong};
    border-radius: 6px;
    padding: 6px 10px;
    color: {text_muted};
    background-color: {raised};
}
QPushButton#recordingSegment[position="left"] { border-top-right-radius: 0; border-bottom-right-radius: 0; }
QPushButton#recordingSegment[position="right"] { border-left: none; border-top-left-radius: 0; border-bottom-left-radius: 0; }
QPushButton#recordingSegment:checked { color: {text}; background-color: {active}; }

/* ── Scene Descriptions dock ─────────────────────────────── */
QDockWidget#AIMediaPanel QWidget { background-color: {surface}; border: none; }
QDockWidget#AIMediaPanel QLabel#clipNameLabel { color: {text}; font-size: 13px; font-weight: 600; }
QDockWidget#AIMediaPanel QLabel#statusLabel { color: {text_muted}; font-size: 12px; }
QDockWidget#AIMediaPanel QLabel#statusLabel[failed="true"] { color: {danger}; }
QDockWidget#AIMediaPanel QTextEdit#descriptionView {
    background: {sunken};
    border: 1px solid {line};
    border-radius: 8px;
    color: {text};
    padding: 10px;
    font-size: 13px;
}
QDockWidget#AIMediaPanel QProgressBar#indexingProgress { background: {active}; border: none; border-radius: 2px; }
QDockWidget#AIMediaPanel QProgressBar#indexingProgress::chunk { background: {accent}; border-radius: 2px; }
QDockWidget#AIMediaPanel QPushButton#refreshBtn { padding: 5px 10px; font-size: 12px; }

/* ── AI chat dock (Qt wrapper around the web view) ──────── */
QDockWidget#AIChatWindow QWidget#AIChatWindowContents { background-color: {surface}; }
QDockWidget#AIChatWindow QFrame#chatPreamble { background-color: {surface}; border: none; border-bottom: 1px solid {line}; }
QDockWidget#AIChatWindow QLabel#chatPreambleLabel { color: {text_muted}; font-size: 12px; }
QDockWidget#AIChatWindow QTextEdit#chatBox { background-color: {surface}; border: none; padding: 8px; }
QDockWidget#AIChatWindow QTextEdit#msgInput { background-color: {sunken}; border: 1px solid {line_strong}; border-radius: 8px; padding: 8px; }
QDockWidget#AIChatWindow QComboBox#modelCombo { background-color: {raised}; }
