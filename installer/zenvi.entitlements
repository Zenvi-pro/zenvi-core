<plist version="1.0">
<dict>
    <!-- For Python ctypes to work. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- For loading unsigned dylib plugins. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- For LLVM. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow DYLD_LIBRARY_PATH etc. (set by the launch-mac launcher to point Qt
         and ImageMagick at bundle-local plugin dirs). Hardened runtime strips
         DYLD_* env vars by default. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
