# Zenvi — production defaults (bundled next to the frozen app as .env.production).
# Local dev: use .env first; keys here only apply if unset (see classes/zenvi_env.py).

# Backend API (zenvi-backend)
ZENVI_BACKEND_URL=https://api.zenvi.pro

# Remotion product-launch service (post-import cleanup). Set to your deployed URL.
# REMOTION_PRODUCT_LAUNCH_URL=

# Browser OAuth login (must match the site that completes /login?state=…)
ZENVI_WEBSITE=https://zenvi.pro

# Supabase — public anon key only; must match zenvi-backend / zenvi.app project
SUPABASE_URL=https://xktarhzbrdnxkaovtdxj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_2-FCBkJ96Ss35jqL9krVEQ_otR5iGmA

# Optional: GitHub owner/repo for update checks (defaults in classes/info.py if unset)
# ZENVI_GITHUB_REPO=Zenvi-pro/zenvi-core
